@inject CourseState State

<div class="md prompt">@CourseState.MarkdownText(CourseState.Text(Item.Prompt))</div>
@for (var i = 0; i < Item.Options.Count; i++)
{
    var index = i;
    <label class="option">
        @if (Item.Correct.Count > 1)
        {
            <input type="checkbox" disabled="@Locked" checked="@_selected.Contains(index)" @onchange="e => Toggle(index, (bool)e.Value!)" />
        }
        else
        {
            <input type="radio" disabled="@Locked" name="@Item.Id" checked="@_selected.Contains(index)" @onchange="() => _selected = [index]" />
        }
        @if (Locked && Run is null && Item.Correct.Contains(index))
        {
            <strong>@CourseState.MarkdownInline(CourseState.Text(Item.Options[index]))</strong>
        }
        else
        {
            @CourseState.MarkdownInline(CourseState.Text(Item.Options[index]))
        }
    </label>
}
@if (!Locked)
{
    <button @onclick="Submit" disabled="@(_selected.Count == 0)">@Strings.Submit</button>
}
@if (Run is not null)
{
    @* Exam: no right/wrong, no explanation until the run is submitted. *@
    @if (_submitted)
    {
        <span class="ok">@Strings.ExamItemSubmitted</span>
    }
}
else if (_passed)
{
    <p class="ok">@Strings.AnswerCorrect</p>
}
else if (Locked)
{
    <p class="bad">@Strings.AnswerWrongLocked</p>
}
else if (_submitted)
{
    <p class="bad">@Strings.AnswerWrong</p>
}
@if (Run is null && Locked && Item.Explanation is not null)
{
    <div class="hint md">@CourseState.MarkdownText(CourseState.Text(Item.Explanation))</div>
}

@code {
    [Parameter, EditorRequired] public Exercise Exercise { get; set; } = null!;
    [Parameter, EditorRequired] public MultipleChoiceItem Item { get; set; } = null!;
    /// <summary>Earlier attempts of this item, oldest first.</summary>
    [Parameter] public IReadOnlyList<Attempt> History { get; set; } = [];
    [Parameter] public EventCallback OnChanged { get; set; }
    /// <summary>Set inside an exam run: the attempt is linked to the run, nothing is revealed, no skill is credited.</summary>
    [Parameter] public ExamRun? Run { get; set; }

    private readonly System.Diagnostics.Stopwatch _clock = System.Diagnostics.Stopwatch.StartNew();
    private HashSet<int> _selected = [];
    private bool _submitted, _passed;
    private int _failed;

    /// <summary>Correct, or out of tries (one retry): the answer is final. In an exam one submission is final.</summary>
    private bool Locked => Run is not null ? _submitted : _passed || _failed >= ProgressDerivation.QuizAttempts;

    protected override void OnInitialized()
    {
        if (History.Count == 0)
            return;
        _submitted = true;
        _passed = History.Any(a => a.Passed);
        _failed = History.Count(a => !a.Passed);
        _selected = (History[^1].Answer ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries).Select(int.Parse).ToHashSet();
    }

    private void Toggle(int index, bool on)
    {
        if (on) _selected.Add(index); else _selected.Remove(index);
    }

    private async Task Submit()
    {
        var attempt = Attempts.MultipleChoice(Exercise.Manifest.Id, Item, _selected, _clock.Elapsed);
        attempt = Run is null ? State.Store.RecordAttempt(attempt, Exercise.Manifest) : State.Store.RecordAttempt(attempt with { ExamRunId = Run.Id });
        _submitted = true;
        _passed = attempt.Passed;
        if (!attempt.Passed)
            _failed++;
        _clock.Restart();
        await OnChanged.InvokeAsync();
    }
}
