<!DOCTYPE html>
<html lang="@Locale.Current">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <HeadOutlet @rendermode="InteractiveServer" />
    <style>
        body { font-family: system-ui, sans-serif; margin: 0; color: #222; background: #fafafa; }
        nav { background: #1e3a5f; padding: 0.6rem 1.5rem; display: flex; flex-wrap: wrap; gap: 0.4rem 1.5rem; align-items: baseline; }
        nav .brand { color: #fff; font-weight: bold; font-size: 1.2rem; margin-right: 1rem; }
        nav a { color: #cfe0f5; text-decoration: none; }
        nav a.active, nav a:hover { color: #fff; text-decoration: underline; }
        nav .lang { margin-left: auto; color: #cfe0f5; font-size: 0.9rem; display: flex; gap: 0.6rem; }
        main { flex: 1; min-width: 0; max-width: 56rem; margin: 0 auto; padding: 1rem 1.5rem 3rem; }
        .shell { display: flex; align-items: flex-start; position: relative; }
        .side { flex: none; width: 16rem; box-sizing: border-box; position: sticky; top: 0; max-height: 100vh; overflow-y: auto; padding: 0.8rem 1rem; background: #fff; border-right: 1px solid #ddd; font-size: 0.95rem; }
        .side ul { list-style: none; padding: 0; margin: 0; }
        .side li { margin: 0.25rem 0; }
        .side li.locked { background: none; }
        .side a { color: #1e3a5f; text-decoration: none; }
        .side a:hover { text-decoration: underline; }
        .side a.active { font-weight: bold; }
        .side .ok, .side .hint { margin-left: 0.3rem; }
        .side-head { margin: 0 0 0.5rem; font-weight: bold; }
        .menu-toggle { display: none; margin: 0; padding: 0.1rem 0.6rem; background: none; color: #fff; border: 1px solid #cfe0f5; border-radius: 3px; }
        @@media (max-width: 64rem) {
            .menu-toggle { display: inline-block; }
            .side { display: none; }
            .side.open { display: block; position: absolute; top: 0; left: 0; z-index: 2; max-height: none; min-height: 100%; box-shadow: 0 0 1rem rgba(0, 0, 0, 0.3); }
        }
        .crumbs { color: #666; font-size: 0.9rem; }
        .card, .item { background: #fff; border: 1px solid #ddd; border-radius: 6px; padding: 0.8rem 1.2rem; margin: 0.8rem 0; }
        .locked { color: #777; background: #f3f3f3; }
        .badge { font-size: 0.8rem; padding: 0.1rem 0.5rem; border-radius: 1rem; background: #ddd; margin-left: 0.4rem; }
        .badge.ok { background: #cfeccf; color: #1a5e1a; }
        .badge.locked { background: #eee; color: #777; }
        .ok { color: #1a5e1a; }
        .bad { color: #a12; }
        .hint { color: #666; font-size: 0.9rem; }
        .md pre { background: #f0f0f0; padding: 0.6rem; overflow-x: auto; }
        .md code { background: #f0f0f0; padding: 0 0.2rem; }
        .md blockquote { background: #f4f2ff; border-left: 4px solid #7a6fd0; margin: 0.8rem 0; padding: 0.4rem 0.9rem; }
        .skills li { list-style: none; margin: 0.2rem 0; }
        .state { color: #666; font-size: 0.85rem; margin-left: 0.4rem; }
        .option { display: block; margin: 0.3rem 0; }
        textarea, input[type=text], input[type=password] { width: 100%; max-width: 50rem; font: inherit; padding: 0.3rem; box-sizing: border-box; }
        button { font: inherit; padding: 0.3rem 0.9rem; margin: 0.4rem 0.4rem 0.4rem 0; cursor: pointer; }
        .path code { user-select: all; word-break: break-all; }
        table { border-collapse: collapse; width: 100%; margin-top: 0.5rem; }
        th, td { text-align: left; vertical-align: top; padding: 0.3rem 0.5rem; border-bottom: 1px solid #eee; }
        td pre { margin: 0; white-space: pre-wrap; font-size: 0.85rem; }
        .errors li { font-family: monospace; font-size: 0.85rem; color: #a12; }
        .errors li.hint { color: #666; }
        nav .admin { color: #fff; margin-left: 1rem; }
        .split { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; align-items: start; }
        .preview { border: 1px solid #ddd; background: #fff; padding: 0 1rem; overflow: auto; }
        pre.diff, pre.answer { background: #f0f0f0; padding: 0.6rem; overflow-x: auto; white-space: pre-wrap; font-size: 0.85rem; }
        .timer { position: sticky; top: 0; z-index: 1; font-size: 1.6rem; font-weight: bold; background: #fff3cd; border: 1px solid #e0c060; border-radius: 6px; padding: 0.5rem 1rem; margin: 0.8rem 0; }
        .timer.bad { background: #f8d7da; border-color: #d9534f; }
        a.button { display: inline-block; border: 1px solid #888; border-radius: 3px; padding: 0.3rem 0.9rem; background: #efefef; color: #222; text-decoration: none; }
        details.card summary { cursor: pointer; }
        .review { display: grid; grid-template-columns: minmax(10rem, 16rem) 1fr; gap: 1rem; align-items: start; }
        .review-list { list-style: none; padding: 0; margin: 0.8rem 0; }
        .review-list li { padding: 0.2rem 0.4rem; }
        .review-list li.current, .files button.current { background: #dde9f7; font-weight: bold; }
        table.code { border-collapse: collapse; width: 100%; background: #fff; border: 1px solid #ddd; font-size: 0.85rem; }
        table.code td { border: 0; padding: 0 0.4rem; vertical-align: top; }
        table.code td.ln { width: 3rem; text-align: right; color: #888; user-select: none; }
        table.code td.ln button { border: 0; background: none; color: inherit; padding: 0; font: inherit; cursor: pointer; }
        table.code td.ln button:hover { color: #1e3a5f; text-decoration: underline; }
        table.code pre { margin: 0; white-space: pre-wrap; }
        table.code tr.marked td { background: #fff8dc; }
        table.code tr.remarks td { padding: 0.2rem 0.4rem 0.4rem; }
        .remark { border-left: 3px solid #1e3a5f; background: #eef4fb; padding: 0.2rem 0.6rem; margin: 0.3rem 0; }
        .remark.private { border-color: #999; background: #f3f3f3; }
        .remark p { margin: 0.2rem 0; }
        .remark .text { white-space: pre-wrap; }
        .remark-form textarea { width: 100%; box-sizing: border-box; }
        @@media (max-width: 760px) { .review { grid-template-columns: 1fr; } }
        .update { background: #fff3cd; border-color: #e0c060; }
        .book { display: inline-block; padding: 0.1rem 0.6rem; border: 1px solid #b8cde6; border-radius: 4px; background: #eef4fb; color: #1e3a5f; text-decoration: none; }
        a.book:hover { background: #dde9f7; text-decoration: underline; }
        span.book { color: #666; background: #f3f3f3; border-color: #ddd; }
    </style>
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
