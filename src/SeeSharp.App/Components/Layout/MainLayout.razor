@inherits LayoutComponentBase
@inject CourseState State
@inject NavigationManager Nav

@{
    var path = Nav.ToBaseRelativePath(Nav.Uri);
    var run = State.Course is null ? null : State.Store.ActiveRun();
}
<nav>
    <button class="menu-toggle" @onclick="() => _menuOpen = !_menuOpen" aria-expanded="@(_menuOpen ? "true" : "false")">☰ @Strings.Menu</button>
    <span class="brand">@Strings.Title</span>
    <NavLink href="" Match="NavLinkMatch.All">@Strings.NavHome</NavLink>
    <NavLink href="modules">@Strings.NavModules</NavLink>
    <NavLink href="exams">@Strings.NavExams</NavLink>
    <NavLink href="feedback">@Strings.NavFeedback</NavLink>
    <NavLink href="settings">@Strings.NavSettings</NavLink>
    @if (State.Review)
    {
        <span class="admin" title="@Strings.ReviewModeHint">@Strings.ReviewModeBadge</span>
    }
    @if (State.Admin)
    {
        <span class="admin">@Strings.NavAdmin</span>
        <NavLink href="admin" Match="NavLinkMatch.All">@Strings.NavAdminCourse</NavLink>
        <NavLink href="admin/skills">@Strings.NavAdminSkills</NavLink>
        <NavLink href="admin/git">@Strings.NavAdminGit</NavLink>
        <NavLink href="admin/review">@Strings.NavAdminReview</NavLink>
    }
    <span class="lang" title="@Strings.LanguageLabel">
        @foreach (var locale in Locale.Supported)
        {
            if (locale == Locale.Current)
            {
                <strong>@Strings.LanguageName(locale)</strong>
            }
            else
            {
                <a href="" @onclick="() => Switch(locale)" @onclick:preventDefault>@Strings.LanguageName(locale)</a>
            }
        }
    </span>
</nav>
<div class="shell">
    @* No menu while an exam runs: every page it links to is closed then. *@
    @if (State.Course is not null && run is null)
    {
        <aside class="side @(_menuOpen ? "open" : "")"><SideMenu Path="@path" /></aside>
    }
    <main>
        @if (_newer is not null)
        {
            <p class="card update">@string.Format(Strings.UpdateAvailable, _newer, UpdateCheck.Current) <code>dotnet tool update -g SeeSharp.Cli</code></p>
        }
        @* Without a course only the settings page makes sense; the other pages assume State.Course is set. *@
        @if (State.Course is null && !path.StartsWith("settings", StringComparison.Ordinal))
        {
            <p class="bad">@Strings.NoCourse <a href="settings">@Strings.GoToSettings</a></p>
        }
        else if (run is not null && !path.StartsWith("exam", StringComparison.Ordinal))
        {
            @* Exam mode: while a run is open the exercise pages would show test output for the same starters, so everything else is closed. *@
            <p class="bad">@Strings.ExamActiveGate <a href="exam/@run.Id">@Strings.ExamResume</a></p>
        }
        else
        {
            @Body
        }
    </main>
</div>

@code {
    private string? _newer;
    private bool _menuOpen; // only matters on narrow screens, where the menu is hidden until toggled

    // Every navigation hands the layout a new Body: close the menu so the page it opened is visible.
    protected override void OnParametersSet() => _menuOpen = false;

    /// <summary>After the first interactive render: nuget.org must never hold up a page.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && (_newer = await UpdateCheck.NewerAsync()) is not null)
            StateHasChanged();
    }

    // The culture is process-wide; a full reload starts a fresh circuit that prerenders and renders in the new language.
    private void Switch(string locale)
    {
        State.SetLocale(locale);
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }
}
