<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Release builds pass -p:Version=<tag without v> (.github/workflows/release.yml); a prerelease version keeps dev runs from asking nuget.org for updates. -->
    <Version>0.0.0-dev</Version>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <PackageId>SeeSharp.Cli</PackageId>
    <ToolCommandName>seesharp</ToolCommandName>
    <PackageOutputPath>$(MSBuildThisFileDirectory)../../nupkg</PackageOutputPath>
    <Authors>Daniel Kuon</Authors>
    <Description>SeeSharp: interaktiver C#-Kurs im Browser mit Übungen, die per Unit-Tests geprüft werden. Interactive C# training with exercises graded by unit tests.</Description>
    <!-- nuget.org only accepts OSI/FSF-approved SPDX expressions; CC BY-NC-SA is shipped as the licence file instead. -->
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/wollume-studios/seesharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/wollume-studios/seesharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>csharp;training;course;education;learning;dotnet-tool</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="/" Visible="false" />
    <InternalsVisibleTo Include="SeeSharp.Cli.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../SeeSharp.App/SeeSharp.App.csproj" />
    <ProjectReference Include="../SeeSharp.Content/SeeSharp.Content.csproj" />
    <ProjectReference Include="../SeeSharp.Core/SeeSharp.Core.csproj" />
    <ProjectReference Include="../SeeSharp.Grading/SeeSharp.Grading.csproj" />
    <ProjectReference Include="../SeeSharp.Ide/SeeSharp.Ide.csproj" />
    <ProjectReference Include="../SeeSharp.Progress/SeeSharp.Progress.csproj" />
  </ItemGroup>
</Project>
